[sub_resource type="GDScript" id="GDScript_gjt4y"]
script/source = "extends Label

@onready var player_sensor: PlayerSensor = $\"../PlayerSensor\"
@onready var enemy: Enemy = $\"..\"

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


func _physics_process(delta: float) -> void:
	text = \"\"
	text = \"Target: \"
	text += enemy.blackboard.target.name if enemy.blackboard.target else \"none\"
	text += \"\\nDistance : \"
	text += str(enemy.blackboard.distance_to_target)
	text += \"\\nSearch Timer : \"
	text += str(player_sensor.search_timer)
"

